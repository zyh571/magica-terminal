{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magica Terminal",
  "version": "0.1.0",
  "identifier": "dev.local.magica-terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Magica Terminal",
        "width": 1000,
        "height": 640,
        "minWidth": 320,
        "minHeight": 200,
        "decorations": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../shell/": "shell/" },
    "category": "DeveloperTool",
    "shortDescription": "A terminal where every pane belongs to a magical girl"
  }
}
