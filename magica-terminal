def load_settings():
    def warn(msg):
        print(f"magica-terminal: {SETTINGS_FILE}: {msg}", file=sys.stderr)

    def valid(default, value):
        if isinstance(default, bool) or isinstance(value, bool):
            return isinstance(default, bool) and isinstance(value, bool)
        if isinstance(default, (int, float)):
            return isinstance(value, (int, float))
        if isinstance(default, tuple):
            return isinstance(value, list) and len(value) == len(default) and all(valid(d, v) for d, v in zip(default, value))
        if isinstance(default, set):
            return isinstance(value, list) and all(isinstance(v, int) and not isinstance(v, bool) for v in value)
        if isinstance(default, dict):
            return isinstance(value, dict) and all(k in default and valid(default[k], v) for k, v in value.items())
        return isinstance(value, type(default))

    try:
        with open(SETTINGS_FILE) as f:
            data = json.load(f)
    except FileNotFoundError:
        return
    except (OSError, ValueError) as e:
        return warn(f"ignored ({e})")
    if not isinstance(data, dict):
        return warn("ignored (not a JSON object)")
    g = globals()
    for key, value in data.items():
        name = key.upper()
        if name not in SETTINGS:
            warn(f"unknown setting {key!r}")
        elif not valid(g[name], value):
            warn(f"bad value for {key!r}: {value!r}")
        else:
            default = g[name]
            g[name] = tuple(value) if isinstance(default, tuple) else set(value) if isinstance(default, set) \
                else {**default, **value} if isinstance(default, dict) else value


