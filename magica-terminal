# ── crush: a match-3 game with the characters' soul gems (`crush` in the shell) ──

class Tile:
    """A head on the board. kind: index into CHARACTERS (None for a Kyubey bomb). special: None, "h" / "v" (striped:
    clears its row / column), "wrapped" (3x3 blast), "armed" (a wrapped head that went off once and goes off again
    after the next fall) or "bomb" (Kyubey: clears every head of one character)."""
    _ids = itertools.count()

    def __init__(self, kind, special=None):
        self.kind, self.special, self.id = kind, special, next(Tile._ids)
        self.born_kind = kind

    def __repr__(self):
        return f"Tile({self.kind}, {self.special})"


class Step:
    """One round of clearing and falling, for the widget to animate in order: transforms (heads turned special by a
    Kyubey combo), fires (specials going off), clears, created (heads that became specials), then falls."""

    def __init__(self, combo):
        self.combo, self.score = combo, 0
        self.transforms, self.fires, self.clears, self.created, self.falls = [], [], [], [], []


class CrushBoard:
    """The rules, without any drawing: grid[r][c] is a Tile (r = 0 at the top)."""

    def __init__(self, size=8, kinds=5, rng=None, luck=None, stripes=None, fade=None):
        self.n, self.kinds = size, kinds
        self.rng = rng or random.Random()
        self.luck = CRUSH_CHAIN_LUCK if luck is None else luck
        self.stripes = CRUSH_LUCKY_STRIPES if stripes is None else stripes
        self.fade = CRUSH_CHAIN_FADE if fade is None else fade
        self.grid = self.fresh()

    def cells(self):
        return [(r, c) for r in range(self.n) for c in range(self.n)]

    def at(self, p):
        return self.grid[p[0]][p[1]]

    def kind(self, r, c):
        t = self.grid[r][c] if 0 <= r < self.n and 0 <= c < self.n else None
        return t.kind if t is not None else None

    def fresh(self):
        """A random board with no matches and at least one move."""
        while True:
            self.grid = [[None] * self.n for _ in range(self.n)]
            for r, c in self.cells():
                banned = set()
                if c >= 2 and self.kind(r, c - 1) == self.kind(r, c - 2):
                    banned.add(self.kind(r, c - 1))
                if r >= 2 and self.kind(r - 1, c) == self.kind(r - 2, c):
                    banned.add(self.kind(r - 1, c))
                self.grid[r][c] = Tile(self.rng.choice([k for k in range(self.kinds) if k not in banned]))
            if self.hint():
                return self.grid

    # ── matching ──
    def runs(self):
        """Straight lines of 3 or more of the same character: [(cells, "h" or "v")]."""
        runs = []
        for horizontal in (True, False):
            for a in range(self.n):
                b = 0
                while b < self.n:
                    r, c = (a, b) if horizontal else (b, a)
                    k, end = self.kind(r, c), b + 1
                    while k is not None and end < self.n and self.kind(*((a, end) if horizontal else (end, a))) == k:
                        end += 1
                    if k is not None and end - b >= 3:
                        runs.append(([(a, i) if horizontal else (i, a) for i in range(b, end)], "h" if horizontal else "v"))
                    b = end
        return runs

    def groups(self):
        """Runs that touch merge into one group (an L, T or + shape): [runs]."""
        groups = []
        for run in self.runs():
            touching = [g for g in groups if any(set(run[0]) & set(r[0]) for r in g)]
            merged = [run] + [r for g in touching for r in g]
            groups = [g for g in groups if g not in touching] + [merged]
        return groups

    def matches_at(self, p):
        return self.match_size(p) > 0

    def match_size(self, p):
        """How many heads the lines of 3+ through `p` hold (0 = no match there)."""
        r, c = p
        k = self.kind(r, c)
        if k is None:
            return 0
        size = 1
        for dr, dc in ((0, 1), (1, 0)):
            length = 1
            for sign in (1, -1):
                i = 1
                while self.kind(r + sign * dr * i, c + sign * dc * i) == k:
                    length, i = length + 1, i + 1
            if length >= 3:
                size += length - 1
        return size if size >= 3 else 0

    def special_for(self, group, swap):
        """The special a group leaves behind and where: 5+ in a line → bomb, L / T / + → wrapped, 4 → striped across
        the match. It goes where the player moved a head, else at the crossing or the middle of the run."""
        longest = max(group, key=lambda run: len(run[0]))
        orientations = {o for _, o in group}
        if len(longest[0]) >= 5:
            special = "bomb"
        elif len(orientations) == 2:
            special = "wrapped"
        elif len(longest[0]) == 4:
            special = "v" if longest[1] == "h" else "h"
        else:
            return None, None
        cells = {p for run, _ in group for p in run}
        moved = [p for p in (swap or ()) if p in cells]
        if moved:
            pos = moved[0]
        elif special == "wrapped":
            h = {p for run, o in group if o == "h" for p in run}
            pos = sorted(h & {p for run, o in group if o == "v" for p in run})[0]
        else:
            pos = longest[0][len(longest[0]) // 2]
        if self.at(pos).special:   # don't overwrite a special: use a plain head of the group, if any
            plain = sorted(p for p in cells if not self.at(p).special)
            if not plain:
                return None, None
            pos = plain[0]
        return special, pos

    # ── specials ──
    def effect(self, tile, p, step):
        """Cells a special hits when it goes off."""
        r, c = p
        if tile.special == "h":
            hit = [(r, i) for i in range(self.n)]
        elif tile.special == "v":
            hit = [(i, c) for i in range(self.n)]
        elif tile.special in ("wrapped", "armed"):
            hit = [(r + dr, c + dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1)]
        else:   # a bomb set off by another special picks a character at random
            present = sorted({t.kind for row in self.grid for t in row if t is not None and t.kind is not None})
            kind = self.rng.choice(present) if present else None
            hit = [q for q in self.cells() if self.at(q) is not None and self.at(q).kind == kind]
            step.fires.append(("bomb", r, c, kind))
            return hit
        step.fires.append((tile.special, r, c, tile.kind))
        return [q for q in hit if 0 <= q[0] < self.n and 0 <= q[1] < self.n]

    def explode(self, start, protected, step):
        """Clear `start`, setting off every special in the way (and every special those hit, …)."""
        queue, cleared, fired = list(start), set(), set()
        while queue:
            p = queue.pop()
            t = self.at(p)
            if p in cleared or p in protected or t is None:
                continue
            if t.special and t.id not in fired:
                fired.add(t.id)
                queue += self.effect(t, p, step)
                if t.special == "wrapped":   # stays, and goes off again after the fall
                    t.special = "armed"
                    protected.add(p)
                    continue
            cleared.add(p)
        return cleared

    def gravity(self, combo=0):
        """Heads fall into the gaps and new ones drop in from above: [(tile, column, from row, to row)]. During a
        chain (combo >= 1) the new ones are luckier, less so each step: some copy the head below or to their left,
        and a few come striped."""
        luck = self.luck * self.fade ** (combo - 1) if combo else 0
        stripes = self.stripes * self.fade ** (combo - 1) if combo else 0
        falls = []
        for c in range(self.n):
            column = [(r, self.grid[r][c]) for r in range(self.n) if self.grid[r][c] is not None]
            new = self.n - len(column)
            fresh = [None] * new
            for i in reversed(range(new)):   # bottom up, so the head below is already known
                below = fresh[i + 1] if i + 1 < new else (column[0][1] if column else None)
                near = [t.kind for t in (below, self.grid[i][c - 1] if c else None) if t and t.kind is not None]
                kind = self.rng.choice(near) if near and self.rng.random() < luck else self.rng.randrange(self.kinds)
                fresh[i] = Tile(kind, self.rng.choice("hv") if self.rng.random() < stripes else None)
            falls += [(t, c, i - new, i) for i, t in enumerate(fresh)]   # start above the board
            falls += [(t, c, r, new + i) for i, (r, t) in enumerate(column) if r != new + i]
            for r, t in enumerate(fresh + [t for _, t in column]):
                self.grid[r][c] = t
        return falls

    # ── a turn ──
    def resolve(self, swap=None, seeds=(), fires=(), transforms=()):
        """Clear matches (and `seeds`), let heads fall, and repeat while anything is left to clear: [Step]."""
        steps, combo, seeds = [], 0, set(seeds)
        while True:
            groups = self.groups()
            armed = {p for p in self.cells() if self.at(p).special == "armed"}
            if not groups and not seeds and not armed:
                return steps
            combo += 1
            step = Step(combo)
            step.fires += fires
            step.transforms += transforms
            fires = transforms = ()
            protected, matched, score = set(), set(), 0
            for group in groups:
                score += sum(10 * len(run) * (len(run) - 1) for run, _ in group)   # 3 → 60, 4 → 120, 5 → 200, 6 → 300 …
                matched |= {p for run, _ in group for p in run}
                special, pos = self.special_for(group, swap)
                if special:
                    t = self.at(pos)
                    t.special, t.kind = special, (None if special == "bomb" else t.kind)
                    protected.add(pos)
                    step.created.append((t, *pos))
            cleared = self.explode((matched - protected) | seeds | armed, protected, step)
            score += 20 * len(cleared - matched)   # heads cleared by specials
            step.score = score * combo
            step.clears = [(self.at(p), *p) for p in sorted(cleared)]
            for r, c in cleared:
                self.grid[r][c] = None
            step.falls = self.gravity(combo)
            steps.append(step)
            swap, seeds = None, set()

    def swap(self, a, b):
        """Swap two neighbours. None if that's not a move; else the Steps it sets off."""
        if abs(a[0] - b[0]) + abs(a[1] - b[1]) != 1:
            return None
        ta, tb = self.at(a), self.at(b)
        self.grid[a[0]][a[1]], self.grid[b[0]][b[1]] = tb, ta
        # Kyubey bomb: swapped with a head, clears every head of that character (striped / wrapped: they all turn
        # into that special first); two bombs clear the board
        bombs = [(t, p) for t, p in ((ta, b), (tb, a)) if t.special == "bomb"]
        if bombs:
            if len(bombs) == 2:
                ta.special = tb.special = None
                return self.resolve(seeds=self.cells(), fires=[("board", *b, None)])
            bomb, bp = bombs[0]
            other, op = (tb, a) if bomb is ta else (ta, b)
            bomb.special = None
            kind, transforms = other.kind, []
            targets = [p for p in self.cells() if self.at(p).kind == kind]
            if other.special in ("h", "v", "wrapped", "armed"):
                for p in targets:
                    t = self.at(p)
                    if not t.special:
                        t.special = self.rng.choice("hv") if other.special in "hv" else "wrapped"
                        transforms.append((t, *p))
            return self.resolve(seeds=set(targets) | {bp}, fires=[("bomb", *bp, kind)], transforms=transforms)
        # two specials together: striped + striped → a row and a column, striped + wrapped → 3 rows and 3 columns,
        # wrapped + wrapped → a 5x5 blast
        if ta.special and tb.special:
            striped = sum(t.special in ("h", "v") for t in (ta, tb))
            if striped == 2:
                ta.special, tb.special = ("h", "v") if a[0] == b[0] else ("v", "h")
                return self.resolve(seeds={a, b})
            ta.special = tb.special = None
            r, c = b
            if striped == 1:
                seeds = {p for p in self.cells() if abs(p[0] - r) <= 1 or abs(p[1] - c) <= 1}
                return self.resolve(seeds=seeds, fires=[("cross", r, c, ta.kind)])
            seeds = {p for p in self.cells() if abs(p[0] - r) <= 2 and abs(p[1] - c) <= 2}
            return self.resolve(seeds=seeds, fires=[("blast", r, c, ta.kind)])
        if not (self.matches_at(a) or self.matches_at(b)):
            self.grid[a[0]][a[1]], self.grid[b[0]][b[1]] = ta, tb
            return None
        return self.resolve(swap=(b, a))

    def moves(self):
        """Every pair of neighbours that makes a move, with a rough worth: heads matched, and swaps of two specials
        or a bomb above any match."""
        for p in self.cells():
            for q in ((p[0], p[1] + 1), (p[0] + 1, p[1])):
                if q[0] >= self.n or q[1] >= self.n:
                    continue
                tp, tq = self.at(p), self.at(q)
                if "bomb" in (tp.special, tq.special) or (tp.special and tq.special):
                    yield p, q, 100
                    continue
                self.grid[p[0]][p[1]], self.grid[q[0]][q[1]] = tq, tp
                worth = self.match_size(p) + self.match_size(q)
                self.grid[p[0]][p[1]], self.grid[q[0]][q[1]] = tp, tq
                if worth:
                    yield p, q, worth

    def hint(self):
        """A pair of neighbours that makes a move, or None."""
        return next(((p, q) for p, q, _ in self.moves()), None)

    def best_move(self):
        """Autoplay's move: one of the worthiest (a random one of them), or None."""
        moves = list(self.moves())
        if not moves:
            return None
        top = max(w for _, _, w in moves)
        p, q, _ = self.rng.choice([m for m in moves if m[2] == top])
        return p, q

    def shuffle(self):
        """Rearrange the heads (specials included) until there's a move and nothing matches already."""
        tiles = [t for row in self.grid for t in row]
        for _ in range(200):
            self.rng.shuffle(tiles)
            self.grid = [tiles[r * self.n:(r + 1) * self.n] for r in range(self.n)]
            if not self.runs() and self.hint():
                return
        self.grid = self.fresh()


